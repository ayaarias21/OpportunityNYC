# Shared environment variables for OpportunityNYC

# MongoDB Atlas connection string from your backend team
# Example format:
# MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/opportunitynyc?retryWrites=true&w=majority
MONGO_URI=

# Optional NYC Open Data app token
NYC_OPEN_DATA_APP_TOKEN=

# Sync batch size
SYNC_PAGE_SIZE=1000
